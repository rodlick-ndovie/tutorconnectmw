# ============================================================================
# PRODUCTION .env for simbiadmin.blueairengineering.com (cPanel Node.js app)
# ----------------------------------------------------------------------------
# On the host: copy this file to ".env" (same folder as package.json) and fill
# in the DB_* values + secret keys. NEVER commit the real .env.
# cPanel's "Setup Node.js App" also lets you set these as Environment Variables
# in its UI instead of a file — either works; a .env file is simplest.
# ============================================================================

NODE_ENV=production
API_PREFIX=/api/v1
# Do NOT set PORT — cPanel/Passenger injects it and the app reads process.env.PORT.

# ---- Database ----
# If MySQL is on THIS same cPanel account, DB_HOST is localhost. If it's on a
# different host, use that hostname and enable Remote MySQL for it.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tutorconnectmw
DB_USER=__FILL_AFTER_UPLOAD__
DB_PASSWORD=__FILL_AFTER_UPLOAD__
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+02:00

# ---- Auth (JWT) ----
# Reuse the SAME secrets as your local backend/.env so existing app logins keep
# working. Copy the two values verbatim.
JWT_ACCESS_SECRET=__COPY_FROM_LOCAL_ENV__
JWT_REFRESH_SECRET=__COPY_FROM_LOCAL_ENV__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=365d

# ---- Public base URL (used to build image/media URLs) ----
PUBLIC_BASE_URL=https://simbiadmin.blueairengineering.com

# ---- Uploads ----
# A normal folder on the cPanel filesystem (persists across restarts). It's
# created automatically on first upload. Served at PUBLIC_BASE_URL/uploads/...
UPLOADS_DIR=./uploads

# ---- PayChangu (TEST keys for now — copy from local .env; swap to live later) ----
PAYCHANGU_PUBLIC_KEY=__COPY_FROM_LOCAL_ENV__
PAYCHANGU_SECRET_KEY=__COPY_FROM_LOCAL_ENV__
PAYCHANGU_CALLBACK_URL=https://simbiadmin.blueairengineering.com/api/v1/payments/paychangu/callback
PAYCHANGU_RETURN_URL=https://simbiadmin.blueairengineering.com/api/v1/payments/return

# ---- Mail (reuse the website SMTP) ----
SMTP_HOST=c5.my-control-panel.com
SMTP_PORT=587
SMTP_USER=info@tutorconnectmw.com
SMTP_PASSWORD=__COPY_FROM_LOCAL_ENV__
MAIL_FROM=TutorConnect Malawi <info@tutorconnectmw.com>

# ---- App version gate (optional) ----
MIN_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0
ANDROID_STORE_URL=
IOS_STORE_URL=
UPDATE_MESSAGE=

# ---- CORS ----
# Native apps send no Origin, so this can stay empty. Add web origins if needed.
CORS_ORIGINS=
