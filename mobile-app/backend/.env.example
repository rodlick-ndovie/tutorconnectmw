# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---- Database (shares the live TutorConnect MySQL DB) ----
# Defaults match a standard WAMP install. Point DB_NAME at a COPY before testing writes.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tutorconnectmw
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+02:00

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Uploads ----
# Path to the website's public/uploads so files are shared with the PHP site.
UPLOADS_DIR=../../website/public/uploads
# Public base URL used to build absolute media URLs returned to the app.
PUBLIC_BASE_URL=http://localhost/tutorconnect_live/website/public

# ---- CORS ----
# Comma-separated list. Expo dev uses exp:// and http://localhost:8081 / 19006.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- PayChangu (Malawi payments) ----
# Test keys start with PUB-TEST-/SEC-TEST- and use the sandbox API automatically.
PAYCHANGU_PUBLIC_KEY=
PAYCHANGU_SECRET_KEY=
PAYCHANGU_CALLBACK_URL=http://localhost:4000/api/v1/payments/paychangu/callback
PAYCHANGU_RETURN_URL=tutorconnect://payments/return

# ---- Mail (OTP / password reset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TutorConnect <no-reply@tutorconnectmw.com>"
